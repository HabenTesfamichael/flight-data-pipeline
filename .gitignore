# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
.conda/
# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
# ---- Testing and coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
# ---- Secrets and local config (never commit API keys) ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
# ---- Data (keep raw data out of Git; commit small samples only) ----
data/raw/
data/processed/
data/interim/
*.csv
*.parquet
*.db
*.sqlite
*.sqlite3
*.xlsx
!data/sample/*.csv
# ---- Models and experiment tracking ----
models/*.pkl
models/*.joblib
models/*.pt
mlruns/
wandb/
# ---- Logs ----
logs/
*.log
# ---- Editors and OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
